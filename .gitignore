# .gitignore for Android project

# Built application files
*.apk
*.aar
*.jar

# Gradle
.gradle/
build/
bin/
gen/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio
.idea/
*.iml
*.iws
*.hprof

# Keystore
*.jks
*.keystore

# Generated code
*/generated/

# Gradle checkouts
.gradle

# IDE
.vscode/
*.swp
*.swo

# Windows thumbnail cache
Thumbs.db
ehthumbs.db
Icon?
.DS_Store

# Qoder-CN specific
.qoder-cn/

# Android build outputs
app/build/

# SDK tools
android-sdk/